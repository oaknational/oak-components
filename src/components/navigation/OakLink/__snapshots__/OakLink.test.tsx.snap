// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`OakLink if target is _blank, it includes screen reader text 1`] = `
.c2 {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.c1 {
  font-family: --var(google-font),Lexend,sans-serif;
}

.c0 {
  display: inline;
  text-align: left;
  align-items: center;
  gap: 0.25rem;
  outline: none;
  border-radius: 0.375rem;
  padding: 0.25rem;
  margin: -0.25rem;
  appearance: none;
  font: inherit;
  background: none;
  border: none;
  text-decoration: underline;
  cursor: pointer;
  color: #0d24c4;
  overflow-wrap: break-word;
}

.c0:focus-visible {
  box-shadow: 0 0 0 0.125rem rgba(255, 229, 85, 100%),0 0 0 0.3rem rgba(87, 87, 87, 100%);
}

.c0:visited {
  color: #081676;
}

.c0:active {
  color: #081676;
  outline: 1px solid #081676;
}

.c0[disabled] {
  cursor: not-allowed;
  color: #808080;
}

@media (hover: hover) {
  .c0:hover,
  .c0:visited:hover {
    color: #0a1d9d;
    text-decoration: underline;
    text-decoration-thickness: 18%;
  }
}

<div>
  <a
    class="c0 "
    target="_blank"
  >
    <span
      class="c1"
    >
      Content goes here
      <span
        class="c2"
      >
         (opens in a new tab)
      </span>
    </span>
  </a>
</div>
`;

